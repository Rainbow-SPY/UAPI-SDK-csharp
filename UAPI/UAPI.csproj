  <Target Name="GetGitInfo" BeforeTargets="CoreCompile">
    <Exec Command="&quot;C:\Program Files\Git\bin\git.exe&quot; rev-parse --short HEAD" StandardOutputImportance="Low" ContinueOnError="WarnAndContinue" ConsoleToMsBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitShortId" />
    </Exec>
    <!-- 3. 拼接最终版本(保留原代码，不变) -->
    <PropertyGroup>
      <GitCommitShortId>$([System.String]::Copy('$(GitCommitShortId)').Trim())</GitCommitShortId>
      <GitCommitShortId Condition="'$(GitCommitShortId)' == ''">Unknown</GitCommitShortId>
      <AssemblyInformationalVersion>$(BaseVersion)-$(GitCommitShortId)</AssemblyInformationalVersion>
    </PropertyGroup>
    <!-- 4. 打印日志(保留原代码，不变) -->
    <Message Text="🔧 提取 BaseVersion：$(BaseVersion)" Importance="High" />
    <Message Text="🔧 生成信息版本：$(AssemblyInformationalVersion)" Importance="High" />
  </Target>
  <!-- 2. 动态生成GitAssemblyInfo.cs(保留using、无覆盖、语法正确、版本注入成功) -->
  <Target Name="WriteAssemblyInfo" AfterTargets="GetGitInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GitAssemblyInfoPath>$(IntermediateOutputPath)\GitAssemblyInfo.cs</GitAssemblyInfoPath>
      <GitCodeContent>[assembly: System.Reflection.AssemblyInformationalVersion("$(AssemblyInformationalVersion)")]</GitCodeContent>
    </PropertyGroup>
    <!-- 写入文件：直接用拼接好的纯文本，一次性写入所有行 -->
    <WriteLinesToFile File="$(GitAssemblyInfoPath)" Lines="$(GitCodeContent)" Overwrite="true" Encoding="UTF-8" WriteOnlyWhenDifferent="true" />
    <!-- 将临时文件加入编译列表，与原有AssemblyInfo.cs合并编译 -->
    <ItemGroup>
      <Compile Include="$(GitAssemblyInfoPath)" />
    </ItemGroup>
  </Target>
